# PostgreSQL, Redis, and a gateway pepper are required; OpenAI remains optional.
# Spring Boot does not automatically read .env; export these values in your shell.
SPRING_PROFILES_ACTIVE=local
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
LOG_LEVEL=INFO
MOCK_PROVIDER_ENABLED=true

# Optional real OpenAI provider. Keep disabled for credential-free mock development.
# Set the key only in your local environment or ignored .env, never in this file.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CONNECT_TIMEOUT=5s
OPENAI_RESPONSE_TIMEOUT=30s
OPENAI_REQUEST_TIMEOUT=40s

# Required: set these only in your ignored .env or trusted environment.
DB_URL=jdbc:postgresql://127.0.0.1:5432/gateway
DB_USERNAME=gateway
DB_PASSWORD=
# Generate a separate high-entropy pepper with: openssl rand -hex 32
GATEWAY_API_KEY_PEPPER=
# Host port for the Compose PostgreSQL service
DB_PORT=5432

# Distributed per-tenant request limits (request tokens, not LLM tokens).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT=1s
REDIS_TIMEOUT=1s
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_RATE=1
RATE_LIMIT_REQUEST_COST=1
RATE_LIMIT_OUTAGE_POLICY=FAIL_CLOSED
