# No credentials are needed for Phases 1–2.
# Spring Boot does not automatically read .env; export these values in your shell.
SPRING_PROFILES_ACTIVE=local
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
LOG_LEVEL=INFO
MOCK_PROVIDER_ENABLED=true

# Optional real OpenAI provider. Keep disabled for credential-free mock development.
# Set the key only in your local environment or ignored .env, never in this file.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CONNECT_TIMEOUT=5s
OPENAI_RESPONSE_TIMEOUT=30s
OPENAI_REQUEST_TIMEOUT=40s
